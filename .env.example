# Copy this file to .env.local and fill in both values.
#
# Where to find them:
#   Supabase dashboard -> your project -> Project Settings -> API
#     VITE_SUPABASE_URL       is "Project URL"
#     VITE_SUPABASE_ANON_KEY  is the "anon" / "publishable" key
#
# The anon key is meant to be public - Vite bakes it into the built JavaScript,
# so it ends up readable in the page source no matter what you do. That is fine.
# What actually protects the guest list is Row Level Security on the rsvps table:
# insert is allowed, select is not. See supabase/schema.sql.
#
# NEVER put the service_role key here. It bypasses RLS entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
